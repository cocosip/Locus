<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Default line: netstandard2.0 and net10.0. Bounded ranges keep consumer conflicts low and avoid cross-major asset mismatches. -->
  <PropertyGroup>
    <LocusMicrosoftVersionRange>[10.0.0,11.0.0)</LocusMicrosoftVersionRange>
    <LocusSqliteVersionRange>[10.0.0,11.0.0)</LocusSqliteVersionRange>
    <LocusSqliteBundleVersion>[2.1.14,3.0.0)</LocusSqliteBundleVersion>
  </PropertyGroup>

  <!-- net9.0: lower the floor to the 9.0 line instead of pinning the latest patch. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <LocusMicrosoftVersionRange>[9.0.0,10.0.0)</LocusMicrosoftVersionRange>
    <LocusSqliteVersionRange>[9.0.0,10.0.0)</LocusSqliteVersionRange>
  </PropertyGroup>

  <!-- net10.0 keeps the newer SQLitePCLRaw major. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <LocusSqliteBundleVersion>[3.0.5,4.0.0)</LocusSqliteBundleVersion>
  </PropertyGroup>

  <!-- Shared line for netstandard2.0, net9.0 and net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(LocusSqliteVersionRange)" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(LocusSqliteBundleVersion)" />
    <PackageVersion Include="System.Threading.Channels" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="System.Text.Json" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(LocusMicrosoftVersionRange)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(LocusMicrosoftVersionRange)" />
  </ItemGroup>

  <!-- net8.0: bounded 8.x ranges; System.Text.Json starts at the first patched release. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[2.1.14,3.0.0)" />
    <PackageVersion Include="System.Threading.Channels" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="System.Text.Json" Version="[8.0.6,9.0.0)" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="[8.0.0,9.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="[8.0.0,9.0.0)" />
  </ItemGroup>

  <!-- Build and test tooling: TFM independent. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Dapper" Version="[2.1.86,3.0.0)" />
    <PackageVersion Include="System.IO.Abstractions" Version="[22.2.0,23.0.0)" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
  </ItemGroup>
</Project>
